type FilterKey =
  | "all"
  | "active"
  | "available"
  | "stuck"
  | "captains"
  | "establishments"
  | "completed";

type ScopeData = {
  role?: string;
  governorate?: AnyObject | null;
  governorateName?: string;
  areas?: AnyObject[];
  areaNames?: string[];
};

type LeaderStats = {
  totalOrders: number;
  activeOrders: number;
  availableOrders: number;
  stuckOrders: number;
  captains: number;
  establishments: number;
  completedToday: number;
};

function unwrap(value: any): any {
  return (
    value?.data?.data ??
    value?.data ??
    value
  );
}

function toArray(value: any): AnyObject[] {
  const v = unwrap(value);

  if (Array.isArray(v)) return v;

  if (Array.isArray(v?.items)) return v.items;
  if (Array.isArray(v?.orders)) return v.orders;
  if (Array.isArray(v?.captains)) return v.captains;
  if (Array.isArray(v?.establishments)) return v.establishments;
  if (Array.isArray(v?.data)) return v.data;

  return [];
}

function numberValue(...values: any[]) {
  for (const value of values) {
    const n = Number(value);

    if (Number.isFinite(n)) {
      return n;
    }
  }

  return 0;
}

function textValue(...values: any[]) {
  for (const value of values) {
    if (
      value !== undefined &&
      value !== null &&
      String(value).trim()
    ) {
      return String(value).trim();
    }
  }

  return "";
}

function normalizeArabic(value: any) {
  return String(value ?? "")
    .toLowerCase()
    .normalize("NFKC")
    .replace(/[\u064B-\u065F\u0670]/g, "")
    .replace(/[أإآ]/g, "ا")
    .replace(/ى/g, "ي")
    .replace(/ة/g, "ه")
    .replace(/ؤ/g, "و")
    .replace(/ئ/g, "ي")
    .replace(/[^\p{L}\p{N}]+/gu, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function getOrderNumber(item: AnyObject) {
  const raw = textValue(
    item?.orderNumber,
    item?.orderNo,
    item?.number,
    item?._id,
  );

  if (!raw) {
    return "—";
  }

  if (raw.startsWith("DZ-")) {
    const match = raw.match(/^DZ-\d+-([0-9]+)/);

    if (match?.[1]) {
      return match[1];
    }

    return raw.replace(/^DZ-\d+-/, "").slice(0, 10);
  }

  return raw.replace(/^#/, "");
}

function getCaptainName(item: AnyObject) {
  return textValue(
    item?.fullName,
    item?.name,
    item?.captain?.fullName,
    item?.captain?.name,
  );
}

function getEstablishmentName(item: AnyObject) {
  return textValue(
    item?.establishmentName,
    item?.establishment?.name,
    item?.shopName,
    item?.restaurantName,
    item?.name,
  );
}

function getAreaName(item: AnyObject) {
  return textValue(
    item?.areaName,
    item?.area?.name,
  );
}

function getGovernorateName(item: AnyObject) {
  return textValue(
    item?.governorateName,
    item?.governorate?.name,
  );
}

function getOrderStatus(item: AnyObject) {
  return normalizeArabic(
    textValue(
      item?.status,
      item?.stage,
      item?.state,
    ),
  );
}

function isCompletedOrder(item: AnyObject) {
  const status = getOrderStatus(item);

  return [
    "completed",
    "complete",
    "delivered",
    "delivery_completed",
    "closed",
  ].some((value) => status.includes(value));
}

function isStuckOrder(item: AnyObject) {
  const status = getOrderStatus(item);

  return Boolean(
    item?.isStuck ||
      item?.stuck ||
      item?.stuckAt ||
      item?.stuckOrder ||
      status.includes("stuck") ||
      status.includes("عالق"),
  );
}

function isAvailableOrder(item: AnyObject) {
  if (
    item?.isAvailable === true ||
    item?.available === true
  ) {
    return true;
  }

  const status = getOrderStatus(item);

  return [
    "available",
    "pending",
    "unassigned",
    "waiting",
    "queued",
    "queue",
    "dispatch_pending",
    "awaiting_captain",
  ].some((value) => status.includes(value));
}

function isActiveOrder(item: AnyObject) {
  const status = getOrderStatus(item);

  if (
    isCompletedOrder(item) ||
    isAvailableOrder(item) ||
    isStuckOrder(item)
  ) {
    return false;
  }

  return [
    "active",
    "assigned",
    "accepted",
    "pickup",
    "picked",
    "picked_up",
    "on_way",
    "on_the_way",
    "delivering",
    "in_progress",
    "out_for_delivery",
    "captain_to_shop",
    "captain_to_customer",
  ].some((value) => status.includes(value));
}

function statusLabel(status: string) {
  const value = normalizeArabic(status);

  if (
    value.includes("completed") ||
    value.includes("delivered")
  ) {
    return "مكتمل";
  }

  if (
    value.includes("cancel") ||
    value.includes("reject")
  ) {
    return "ملغي";
  }

  if (
    value.includes("stuck") ||
    value.includes("عالق")
  ) {
    return "عالق";
  }

  if (
    value.includes("available") ||
    value.includes("pending") ||
    value.includes("unassigned") ||
    value.includes("waiting")
  ) {
    return "متاح";
  }

  if (
    value.includes("assigned") ||
    value.includes("active") ||
    value.includes("on_the_way") ||
    value.includes("delivering")
  ) {
    return "نشط";
  }

  return textValue(status) || "غير محدد";
}

function statusTone(status: string) {
  const label = statusLabel(status);

  if (label === "مكتمل") {
    return {
      backgroundColor: "#ECFDF3",
      color: "#222222",
    };
  }

  if (label === "عالق") {
    return {
      backgroundColor: "#F3F3F3",
      color: "#111111",
    };
  }

  if (label === "متاح") {
    return {
      backgroundColor: "#F4F4F4",
      color: "#C2410C",
    };
  }

  if (label === "نشط") {
    return {
      backgroundColor: "#F3F3F3",
      color: "#222222",
    };
  }

  return {
    backgroundColor: "#F3F3F3",
    color: "#666666",
  };
}

function extractDashboardStats(raw: any): LeaderStats {
  const root = unwrap(raw);

  const stats =
    root?.stats ??
    root?.statistics ??
    root?.summary ??
    root;

  return {
    totalOrders: numberValue(
      stats?.totalOrders,
      stats?.orders,
      stats?.total,
    ),

    activeOrders: numberValue(
      stats?.activeOrders,
      stats?.active,
    ),

    availableOrders: numberValue(
      stats?.availableOrders,
      stats?.available,
    ),

    stuckOrders: numberValue(
      stats?.stuckOrders,
      stats?.stuck,
      stats?.stuckOrdersCount,
    ),

    captains: numberValue(
      stats?.captains,
      stats?.captainCount,
      stats?.captainsCount,
    ),

    establishments: numberValue(
      stats?.establishments,
      stats?.establishmentCount,
      stats?.shops,
      stats?.restaurants,
    ),

    completedToday: numberValue(
      stats?.completedToday,
      stats?.completedOrdersToday,
      stats?.todayCompleted,
    ),
  };
}

function mergeStats(
  dashboard: LeaderStats,
  orders: AnyObject[],
  captains: AnyObject[],
  establishments: AnyObject[],
) {
  const completed = orders.filter(isCompletedOrder).length;
  const active = orders.filter(isActiveOrder).length;
  const available = orders.filter(isAvailableOrder).length;
  const stuck = orders.filter(isStuckOrder).length;

  return {
    totalOrders:
      dashboard.totalOrders || orders.length,

    activeOrders:
      dashboard.activeOrders || active,

    availableOrders:
      dashboard.availableOrders || available,

    stuckOrders:
      dashboard.stuckOrders || stuck,

    captains:
      dashboard.captains || captains.length,

    establishments:
      dashboard.establishments ||
      establishments.length,

    completedToday:
      dashboard.completedToday || completed,
  };
}

function scopeTitle(scope: ScopeData) {
  if (scope.role === "area_leader") {
    return "قائد منطقة";
  }

  if (scope.role === "governorate_leader") {
    return "قائد محافظة";
  }

  return "قائد";
}

function scopeDescription(scope: ScopeData) {
  const governorate = textValue(
    scope.governorateName,
    scope.governorate?.name,
  );

  const areas =
    scope.areaNames?.length
      ? scope.areaNames
      : (scope.areas || [])
          .map((item) =>
            textValue(
              item?.name,
              item?.area?.name,
            ),
          )
          .filter(Boolean);

  if (scope.role === "area_leader") {
    if (areas.length === 1) {
      return `${governorate} · ${areas[0]}`;
    }

    if (areas.length > 1) {
      return `${governorate} · ${areas.length} مناطق`;
    }
  }

  return governorate || "نطاق التشغيل";
}

export default function LeaderHomeScreen() {
  const { width } = useWindowDimensions();

  const [scope, setScope] =
    useState<ScopeData>({});

  const [orders, setOrders] =
    useState<AnyObject[]>([]);

  const [captains, setCaptains] =
    useState<AnyObject[]>([]);

  const [establishments, setEstablishments] =
    useState<AnyObject[]>([]);

  const [dashboardStats, setDashboardStats] =
    useState<LeaderStats>({
      totalOrders: 0,
      activeOrders: 0,
      availableOrders: 0,
      stuckOrders: 0,
      captains: 0,
      establishments: 0,
      completedToday: 0,
    });

  const [filter, setFilter] =
    useState<FilterKey>("all");

  const [search, setSearch] =
    useState("");

  const [loading, setLoading] =
    useState(true);

  const [refreshing, setRefreshing] =
    useState(false);

  const [error, setError] =
    useState("");

  const loadData = useCallback(
    async (refresh = false) => {
      try {
        if (refresh) {
          setRefreshing(true);
        } else {
          setLoading(true);
        }

        setError("");

        const [
          dashboardResult,
          ordersResult,
          captainsResult,
          establishmentsResult,
          scopeResult,
        ] = await Promise.all([
          apiGet("/leaders/me/dashboard"),
          apiGet("/leaders/me/orders"),
          apiGet("/leaders/me/captains"),
          apiGet("/leaders/me/establishments"),
          apiGet("/leaders/me/scope"),
        ]);

        const nextOrders =
          toArray(ordersResult);

        const nextCaptains =
          toArray(captainsResult);

        const nextEstablishments =
          toArray(establishmentsResult);

        const nextScope =
          unwrap(scopeResult) || {};

        setScope(nextScope);
        setOrders(nextOrders);
        setCaptains(nextCaptains);
        setEstablishments(nextEstablishments);

        setDashboardStats(
          mergeStats(
            extractDashboardStats(
              dashboardResult,
            ),
            nextOrders,
            nextCaptains,
            nextEstablishments,
          ),
        );
      } catch (err: any) {
        setError(
          textValue(
            err?.response?.data?.message,
            err?.message,
            "تعذر تحميل لوحة القائد.",
          ),
        );
      } finally {
        setLoading(false);
        setRefreshing(false);
      }
    },
    [],
  );

  useEffect(() => {
    loadData();
  }, [loadData]);

  const stats = dashboardStats;

  const activeSearch =
    normalizeArabic(search);

  const resultData = useMemo(() => {
    let list: AnyObject[] = [];

    let type:
      | "orders"
      | "captains"
      | "establishments" =
      "orders";

    if (filter === "captains") {
      list = captains;
      type = "captains";
    } else if (filter === "establishments") {
      list = establishments;
      type = "establishments";
    } else {
      list = orders;
      type = "orders";

      if (filter === "active") {
        list = list.filter(isActiveOrder);
      }

      if (filter === "available") {
        list = list.filter(isAvailableOrder);
      }

      if (filter === "stuck") {
        list = list.filter(isStuckOrder);
      }

      if (filter === "completed") {
        list = list.filter(isCompletedOrder);
      }
    }

    if (!activeSearch) {
      return {
        type,
        items: list.slice(0, 8),
      };
    }

    const filtered = list.filter(
      (item) => {
        const searchable =
          normalizeArabic(
            [
              getOrderNumber(item),
              getCaptainName(item),
              getEstablishmentName(item),
              getAreaName(item),
              getGovernorateName(item),
              item?.phone,
              item?.email,
              item?.customerName,
              item?.customer?.name,
              item?.customer?.phone,
              item?.address,
              item?.status,
              item?.type,
            ]
              .filter(Boolean)
              .join(" "),
          );

        return searchable.includes(
          activeSearch,
        );
      },
    );

    return {
      type,
      items: filtered.slice(0, 8),
    };
  }, [
    activeSearch,
    captains,
    establishments,
    filter,
    orders,
  ]);

  const completionPercentage =
    stats.totalOrders > 0
      ? Math.min(
          Math.round(
            (stats.completedToday /
              stats.totalOrders) *
              100,
          ),
          100,
        )
      : 0;

  const cardWidth =
    width >= 1200
      ? "23.5%"
