type AnyObject = Record<string, any>;

type RNIconProps = {
  color?: string;
  size?: number;
};

function Glyph({
  symbol,
  color = "#111111",
  size = 20,
}: RNIconProps & { symbol: string }) {
  return (
    <Text
      style={{
        color,
        fontSize: size,
        lineHeight: size + 3,
        fontWeight: "900",
        textAlign: "center",
      }}
    >
      {symbol}
    </Text>
  );
}

